      "peak_dbfs": -3.8277,
      "rms_dbfs": -17.782,
      "music_rms_dbfs": -41.6327
    },
    {
      "index": 4,
      "text": "Tiếp theo là bài có trích dẫn. Nguyên văn tiếng Anh được hiển thị bằng bản dịch tiếng Trung.",
      "start": 29.0,
      "end": 37.0,
      "placed_start": 29.12,
      "placed_end": 34.42,
      "tempo": 1.0,
      "source_duration": 6.192,
      "trimmed_duration": 5.3,
      "placed_duration": 5.3,
      "available_duration": 7.73,
      "trimmed_leading_seconds": 0.13,
      "trimmed_trailing_seconds": 0.762,
      "peak": 0.6034215688705444,
      "rms": 0.1231947120297698,
      "peak_dbfs": -4.3876,
      "rms_dbfs": -18.1882,
      "music_rms_dbfs": -38.2691
    },
    {
      "index": 5,
      "text": "Thời gian chờ đã được rút ngắn khi biên tập. Khi gợi ý xuất hiện, hãy kiểm tra nội dung.",
      "start": 37.0,
      "end": 45.0,
      "placed_start": 37.12,
      "placed_end": 42.78,
      "tempo": 1.0,
      "source_duration": 6.528,
      "trimmed_duration": 5.66,
      "placed_duration": 5.66,
      "available_duration": 7.73,
      "trimmed_leading_seconds": 0.11,
      "trimmed_trailing_seconds": 0.758,
