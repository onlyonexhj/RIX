      "peak": 0.6334236860275269,
      "rms": 0.11949347490266703,
      "peak_dbfs": -3.9661,
      "rms_dbfs": -18.4531,
      "music_rms_dbfs": -39.8116
    },
    {
      "index": 2,
      "text": "Trợ lý đọc ngữ cảnh, hiện phong cách, số câu và ngôn ngữ, rồi tự tạo gợi ý.",
      "start": 11.0,
      "end": 19.0,
      "placed_start": 11.12,
      "placed_end": 16.24,
      "tempo": 1.0,
      "source_duration": 6.0,
      "trimmed_duration": 5.12,
      "placed_duration": 5.12,
      "available_duration": 7.73,
      "trimmed_leading_seconds": 0.12,
