      "rms_dbfs": -16.9448,
      "music_rms_dbfs": -47.1936
    },
    {
      "index": 1,
      "text": "Đây là bản ghi trên trang X thực tế. Trước tiên, mở hộp trả lời của bài đăng.",
      "start": 3.0,
      "end": 11.0,
      "placed_start": 3.12,
      "placed_end": 8.51,
      "tempo": 1.0,
      "source_duration": 6.264,
      "trimmed_duration": 5.39,
      "placed_duration": 5.39,
      "available_duration": 7.73,
      "trimmed_leading_seconds": 0.12,
