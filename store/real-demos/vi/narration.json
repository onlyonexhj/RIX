    {
      "index": 0,
      "text": "Trợ lý trả lời X AI.",
      "start": 0.0,
      "end": 3.0,
      "placed_start": 0.12,
      "placed_end": 1.97,
      "tempo": 1.0,
      "source_duration": 2.736,
