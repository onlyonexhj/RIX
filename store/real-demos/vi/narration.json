      "peak": 0.701455295085907,
      "rms": 0.12861210341326007,
      "peak_dbfs": -3.08,
      "rms_dbfs": -17.8144,
      "music_rms_dbfs": -50.905
    },
    {
      "index": 3,
      "text": "Gợi ý đầu tự điền vào ô trả lời. Sau khi kiểm tra, người dùng nhấn Trả lời trên X. Trang xác nhận bài đã được gửi.",
      "start": 19.0,
      "end": 29.0,
      "placed_start": 19.12,
      "placed_end": 26.73,
      "tempo": 1.0,
      "source_duration": 8.496,
      "trimmed_duration": 7.61,
