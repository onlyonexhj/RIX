      "peak_dbfs": -3.6228,
      "rms_dbfs": -17.8073,
      "music_rms_dbfs": -40.8005
    },
    {
      "index": 6,
      "text": "Gợi ý đầu lại tự điền. Người dùng nhấn Trả lời và X xác nhận đã gửi. Bạn vẫn có thể sửa trước khi đăng.",
      "start": 45.0,
      "end": 55.0,
      "placed_start": 45.12,
      "placed_end": 53.01,
      "tempo": 1.0,
      "source_duration": 8.784,
