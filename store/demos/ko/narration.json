      "music_rms_dbfs": -39.5835
    },
    {
      "index": 4,
      "text": "답글 개수와 언어를 고르세요. 한국어 후보를 만들고 입력합니다.",
      "start": 28.0,
      "end": 35.0,
      "placed_start": 28.12,
